{
  "typeName": "AWS::OpenSearchService::VpcEndpointAccess",
  "description": "Lets an AWS account, or an AWS service, create interface VPC endpoints to an OpenSearch Service VPC domain, made with AuthorizeVpcEndpointAccess. Set exactly one of Account and Service. AWS has no call that changes an authorization, so every property is create-only.",
  "definitions": {
    "ServiceOptions": {
      "type": "object",
      "description": "The options of a service principal.",
      "properties": {
        "SupportedRegions": {
          "type": "array",
          "description": "The Regions the service can reach the domain from.",
          "insertionOrder": false,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "DomainName": {
      "type": "string",
      "description": "The name of the domain to give access to.",
      "minLength": 3,
      "maxLength": 28,
      "pattern": "^[a-z][a-z0-9\\-]+$"
    },
    "Account": {
      "type": "string",
      "description": "The ID of the AWS account to give access to.",
      "pattern": "^[0-9]+$"
    },
    "Service": {
      "type": "string",
      "description": "The service principal to give access to.",
      "enum": ["application.opensearchservice.amazonaws.com"]
    },
    "ServiceOptions": {
      "$ref": "#/definitions/ServiceOptions"
    },
    "Principal": {
      "type": "string",
      "description": "The account ID or the service principal that has access: Account or Service."
    },
    "PrincipalType": {
      "type": "string",
      "description": "The type of the principal.",
      "enum": ["AWS_ACCOUNT", "AWS_SERVICE"]
    }
  },
  "required": ["DomainName"],
  "additionalProperties": false,
  "primaryIdentifier": ["/properties/DomainName", "/properties/Principal"],
  "createOnlyProperties": [
    "/properties/DomainName",
    "/properties/Account",
    "/properties/Service",
    "/properties/ServiceOptions"
  ],
  "readOnlyProperties": ["/properties/Principal", "/properties/PrincipalType"],
  "handlers": {
    "create": {
      "permissions": [
        "es:AuthorizeVpcEndpointAccess",
        "es:ListVpcEndpointAccess"
      ]
    },
    "read": {
      "permissions": ["es:ListVpcEndpointAccess"]
    },
    "update": {
      "permissions": ["es:ListVpcEndpointAccess"]
    },
    "delete": {
      "permissions": ["es:RevokeVpcEndpointAccess", "es:ListVpcEndpointAccess"]
    }
  }
}
