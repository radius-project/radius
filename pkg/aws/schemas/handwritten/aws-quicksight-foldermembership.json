{
  "typeName": "AWS::QuickSight::FolderMembership",
  "description": "Adds a Quick Sight asset, such as a dashboard, analysis, or dataset, to a folder, made with CreateFolderMembership. AWS has no call that changes a membership, so every property is create-only.",
  "properties": {
    "AwsAccountId": {
      "type": "string",
      "description": "The ID of the AWS account that has the folder.",
      "minLength": 12,
      "maxLength": 12,
      "pattern": "^[0-9]{12}$"
    },
    "FolderId": {
      "type": "string",
      "description": "The ID of the folder.",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[\\w\\-]+$"
    },
    "MemberType": {
      "type": "string",
      "description": "The type of the asset.",
      "enum": ["DASHBOARD", "ANALYSIS", "DATASET", "DATASOURCE", "TOPIC"]
    },
    "MemberId": {
      "type": "string",
      "description": "The ID of the asset.",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[\\w\\-]+$"
    },
    "MemberArn": {
      "type": "string",
      "description": "The ARN of the asset."
    }
  },
  "required": ["AwsAccountId", "FolderId", "MemberType", "MemberId"],
  "additionalProperties": false,
  "primaryIdentifier": [
    "/properties/AwsAccountId",
    "/properties/FolderId",
    "/properties/MemberType",
    "/properties/MemberId"
  ],
  "createOnlyProperties": [
    "/properties/AwsAccountId",
    "/properties/FolderId",
    "/properties/MemberType",
    "/properties/MemberId"
  ],
  "readOnlyProperties": ["/properties/MemberArn"],
  "handlers": {
    "create": {
      "permissions": [
        "quicksight:CreateFolderMembership",
        "quicksight:ListFolderMembers",
        "quicksight:UpdateAnalysisPermissions",
        "quicksight:UpdateDashboardPermissions",
        "quicksight:UpdateDataSetPermissions",
        "quicksight:UpdateDataSourcePermissions",
        "quicksight:UpdateTopicPermissions"
      ],
      "timeoutInMinutes": 10
    },
    "read": {
      "permissions": ["quicksight:ListFolderMembers"]
    },
    "update": {
      "permissions": ["quicksight:ListFolderMembers"],
      "timeoutInMinutes": 10
    },
    "delete": {
      "permissions": [
        "quicksight:DeleteFolderMembership",
        "quicksight:ListFolderMembers",
        "quicksight:UpdateAnalysisPermissions",
        "quicksight:UpdateDashboardPermissions",
        "quicksight:UpdateDataSetPermissions",
        "quicksight:UpdateDataSourcePermissions",
        "quicksight:UpdateTopicPermissions"
      ],
      "timeoutInMinutes": 10
    }
  }
}
