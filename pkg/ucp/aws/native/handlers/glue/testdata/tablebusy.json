{
  "source": "api-reference",
  "inputs": {
    "RADIUS_REC_ACCOUNT_ID": "123456789012",
    "RADIUS_REC_GLUE_DATABASE": "radius_rec_example",
    "RADIUS_REC_GLUE_TABLE": "radius_rec_events"
  },
  "interactions": [
    {
      "service": "Glue",
      "operation": "GetPartitionIndexes",
      "request": "{\"CatalogId\":\"123456789012\",\"DatabaseName\":\"radius_rec_example\",\"TableName\":\"radius_rec_events\"}",
      "status": 200,
      "headers": {
        "Content-Type": "application/x-amz-json-1.1"
      },
      "body": "{\"PartitionIndexDescriptorList\":[{\"IndexName\":\"radius_rec_by_region\",\"IndexStatus\":\"ACTIVE\",\"Keys\":[{\"Name\":\"region\",\"Type\":\"string\"}]}]}"
    },
    {
      "service": "Glue",
      "operation": "CreatePartitionIndex",
      "request": "{\"CatalogId\":\"123456789012\",\"DatabaseName\":\"radius_rec_example\",\"PartitionIndex\":{\"IndexName\":\"radius_rec_by_date\",\"Keys\":[\"year\",\"month\"]},\"TableName\":\"radius_rec_events\"}",
      "status": 400,
      "headers": {
        "Content-Type": "application/x-amz-json-1.1"
      },
      "body": "{\"__type\":\"ResourceNumberLimitExceededException\",\"Message\":\"Index radius_rec_by_region is in DELETING state. Only 1 index can be created or deleted simultaneously per table.\"}"
    }
  ]
}
