{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "childName": {
      "type": "string"
    }
  },
  "resources": {
    "skippedChild": {
      "condition": false,
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('childName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    }
  },
  "outputs": {
    "result": {
      "type": "string",
      "value": "condition-skipped"
    }
  }
}
