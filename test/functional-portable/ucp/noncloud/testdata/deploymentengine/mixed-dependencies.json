{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    }
  },
  "imports": {
    "radius": {
      "provider": "Radius",
      "version": "latest"
    }
  },
  "resources": {
    "legacyPredecessor": {
      "import": "radius",
      "type": "Applications.Core/extenders@2023-10-01-preview",
      "properties": {
        "name": "[format('{0}-first', parameters('name'))]",
        "location": "global",
        "properties": {
          "environment": "[parameters('environment')]",
          "resourceProvisioning": "manual"
        }
      }
    },
    "legacyDependent": {
      "import": "radius",
      "type": "Applications.Core/extenders@2023-10-01-preview",
      "properties": {
        "name": "[format('{0}-second', parameters('name'))]",
        "location": "global",
        "properties": {
          "environment": "[parameters('environment')]",
          "resourceProvisioning": "manual"
        }
      },
      "dependsOn": ["legacyPredecessor"]
    },
    "modernDependent": {
      "import": "radius",
      "type": "Radius.Core/recipePacks@2025-08-01-preview",
      "properties": {
        "name": "[parameters('name')]",
        "location": "global",
        "properties": {
          "recipes": {}
        }
      },
      "dependsOn": ["legacyPredecessor"]
    }
  }
}
