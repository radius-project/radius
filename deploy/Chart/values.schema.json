{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "rbac": {
          "anyOf": [{ "type": ["object", "null"] }, { "enum": [false, 0, ""] }],
          "properties": {
            "certificates": {
              "type": ["object", "null"],
              "properties": {
                "issuerRef": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "maxLength": 253 },
                    "kind": { "type": "string" },
                    "group": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
