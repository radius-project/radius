FROM gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087

ARG TARGETPLATFORM

WORKDIR /

COPY ${TARGETPLATFORM}/ucpd /ucpd
COPY deploy/manifest/built-in-providers/self-hosted/ /manifest/built-in-providers/

USER 65532:65532

ENTRYPOINT ["/ucpd"]
