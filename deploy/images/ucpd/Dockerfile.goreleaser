FROM gcr.io/distroless/static-debian13:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931

ARG TARGETPLATFORM

WORKDIR /

COPY ${TARGETPLATFORM}/ucpd /ucpd
COPY deploy/manifest/built-in-providers/self-hosted/ /manifest/built-in-providers/

USER 65532:65532

ENTRYPOINT ["/ucpd"]
